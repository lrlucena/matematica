# Conjuntos

tipo T = Inteiro

tipo Conjunto
  _elem: Lista[T]
  val elementos = _elem.ordene.divida_quando(_ <> _).mapeie(_.cabeça)

  def união(b: Conjunto) = Conjunto(elementos + b.elementos)
  
  def interseção(b: Conjunto) = 
    Conjunto(para elem em elementos se b.elementos.contém(elem) gere elem fim)
  
  def diferença(b: Conjunto) = Conjunto(elementos - b.elementos)
  
  def complemento(universo: Conjunto) = universo.diferença(isto)
fim

tipo Relacao = Lista[(T, T)]

###

def produto_cartesiano(a, b: Conjunto) =
  para x em a.elementos, y em b.elementos gere (x, y) fim

def inversa(relacao: Relacao) =
  para (x, y) em relacao gere (y, x) fim

A = Conjunto([1, 2, 3])
B = Conjunto([4, 5])

escreva produto_cartesiano(A, B)

R = [(1, 2), (2, 3), (3, 1)]
escreva inversa(R)