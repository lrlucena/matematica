# Definições

## Verifica se a|b
## um inteiro a divide um inteiro b se existir n inteiro tal que a*n = b
def divide(a, b: Inteiro): Lógico = 
  para n de -100 até 100
    se a * n == b
    gere n
  fim.tamanho > 0

x, y = 7, 10
escreva "{x} divide {y}: {divide(x, y)}"  

## Forma computacionalmente mais eficiente
def divide2(a, b: Inteiro) = escolha (a, b)
  caso (_, 0) => verdadeiro
  caso (0, _) => falso
  caso (a, b) => b mod a == 0
fim

## a é par se 2|a
def par(a: Inteiro): Lógico = divide(2, a)

## a é ímpar se existe n tal que a = 2*n + 1
def ímpar(a: Inteiro): Lógico =
  para n de -20 até 20
    se a == 2 * n + 1
    gere verdadeiro
  fim.tamanho > 0

## Forma computacionalmente mais eficiente
def ímpar2(a: Inteiro): Lógico = não par(a)

## Retorna a lista de divisores de a
def divisores(a: Inteiro): Lista[Inteiro] =
  para n de -a até a
    se divide(n, a)
    gere n
  fim

def divisores_positivos(a: Inteiro) = divisores(a).selecione(_ > 0)


## a é primo se ele for maior do que 1 e
## seus únicos divisores positivos são 1 e ele mesmo
def primo(a: Inteiro) = a > 1 e divisores_positivos(a) == [1, a]

## a é composto se tem algum divisor positivo além de 1 e ele mesmo
def composto(a: Inteiro) = 
  divisores_positivos(a)
    .selecione(n => n > 1 e n < a)
    .tamanho > 0

## a é composto se tem algum divisor positivo além de 1 e ele mesmo
def composto2(a: Inteiro) = a > 0 e divisores_positivos(a) <> [1, a]

## a é composto se for maior do que 1 e não for primo
def composto3(a: Inteiro) = a > 1 e não primo(a)

## a é quadrado perfeito se existe n tal que n*n = a
def quadrado_perfeito(a: Inteiro) =
  para n de 0 até a
    se n * n == a
    gere verdadeiro
  fim.tamanho > 0

